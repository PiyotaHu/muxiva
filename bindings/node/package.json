{
  "name": "@voxa/core",
  "version": "0.1.0",
  "description": "Node-API bindings and bounded TypeScript node execution domain for Voxa",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/PiyotaHu/Voxa.git", "directory": "bindings/node" },
  "homepage": "https://github.com/PiyotaHu/Voxa#readme",
  "bugs": { "url": "https://github.com/PiyotaHu/Voxa/issues" },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": { ".": { "types": "./index.d.ts", "import": "./index.js" } },
  "files": ["index.js", "index.d.ts", "worker.mjs", "graph-worker.mjs", "README.md", "native/*.node", "npm"],
  "engines": { "node": ">=20 <25" },
  "napi": { "binaryName": "voxa", "targets": ["aarch64-apple-darwin", "x86_64-unknown-linux-gnu"] },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/voxa-node/Cargo.toml --output-dir native",
    "build:debug": "napi build --platform --manifest-path ../../crates/voxa-node/Cargo.toml --output-dir native",
    "test": "node --test __tests__/*.test.mjs",
    "check": "npm run build:debug && npm test"
  },
  "dependencies": { "@types/node": "22.15.3" },
  "devDependencies": { "@napi-rs/cli": "3.8.0", "typescript": "5.9.2" }
}
