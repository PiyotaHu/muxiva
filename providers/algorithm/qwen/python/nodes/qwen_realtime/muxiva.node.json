{
  "format": "muxiva.node/v1",
  "package_id": "qwen_realtime",
  "display_name": "Qwen Audio Realtime",
  "node_type": "qwen.audio_realtime",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenAudioRealtimeNode",
  "category": "algorithm",
  "capability": "speech.to.speech.realtime",
  "summary": "Runs turn detection, speech understanding, reasoning, and speech generation in one realtime session.",
  "connection_id": "dashscope",
  "documentation": "https://piyotahu.github.io/muxiva/en/providers/qwen/audio-realtime/",
  "tags": ["speech-to-speech", "realtime", "multimodal", "duplex"],
  "ports": [
    { "name": "audio_in", "direction": "input", "frame_type": "audio", "schema": { "encoding": "pcm_s16le", "sample_rate_hz": 16000, "channels": 1, "streaming": true } },
    { "name": "audio_out", "direction": "output", "frame_type": "audio", "schema": { "encoding": "pcm_s16le", "sample_rate_hz": 24000, "channels": 1, "streaming": true } },
    { "name": "transcript_preview_out", "direction": "output", "frame_type": "text", "schema": { "semantics": ["user_transcript_partial"], "streaming": true } },
    { "name": "transcript_out", "direction": "output", "frame_type": "text", "schema": { "semantics": ["user_transcript_final"], "streaming": false } },
    { "name": "response_text_out", "direction": "output", "frame_type": "text", "schema": { "semantics": ["assistant_transcript"], "streaming": true } },
    { "name": "client_event_out", "direction": "output", "frame_type": "event", "schema": { "semantics": ["client_realtime_event"], "streaming": true } },
    { "name": "signal_out", "direction": "output", "frame_type": "signal", "schema": { "semantics": ["graph_control"], "streaming": true } }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen-audio-3.0-realtime-flash" },
      "voice": { "type": "string", "default": "longanqian" },
      "instructions": { "type": "string", "default": "You are a concise, helpful realtime voice assistant." },
      "turn_detection": { "type": "string", "enum": ["server_vad", "smart_turn"], "default": "server_vad" },
      "vad_threshold": { "type": "number", "minimum": -1, "maximum": 1, "default": 0.35 },
      "silence_duration_ms": { "type": "integer", "minimum": 200, "maximum": 6000, "default": 1000 }
    },
    "required": ["model", "voice", "instructions", "turn_detection"],
    "additionalProperties": false
  }
}
