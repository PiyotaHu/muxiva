{
  "format": "muxiva.node/v1",
  "package_id": "xiaozhi_event_encoder",
  "display_name": "Xiaozhi Device Event Encoder",
  "node_type": "xiaozhi.event_encoder",
  "language": "python",
  "factory_version": "1.1.0",
  "kind": "sink",
  "entrypoint": "node:XiaozhiEventEncoderNode",
  "category": "transport",
  "capability": "xiaozhi.protocol.encode",
  "summary": "Maps transcripts and assistant response text into the Xiaozhi stt/tts device messages and clears queued audio on barge-in.",
  "documentation": "https://piyotahu.github.io/muxiva/providers/xiaozhi/event-encoder/",
  "tags": ["xiaozhi", "protocol", "stt", "tts", "display"],
  "ports": [
    {
      "name": "transcript_in",
      "direction": "input",
      "frame_type": "text",
      "schema": { "semantics": ["user_transcript_final"], "streaming": false }
    },
    {
      "name": "response_text_in",
      "direction": "input",
      "frame_type": "text",
      "schema": { "semantics": ["assistant_transcript"], "streaming": true }
    },
    {
      "name": "event_in",
      "direction": "input",
      "frame_type": "event",
      "schema": { "semantics": ["speech_state", "response_state"], "streaming": true }
    },
    {
      "name": "signal_in",
      "direction": "input",
      "frame_type": "signal",
      "schema": { "semantics": ["turn_cancellation"], "signal_names": ["muxiva.turn.cancelled"] }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "control_host": { "type": "string", "default": "127.0.0.1" },
      "control_port": { "type": "integer", "default": 8889 },
      "device_command_topics": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "description": "Opt-in Event topics whose command payload may be encoded for this transport."
      },
      "device_command_allowlist": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "description": "Deployment-owned command types allowed to leave this session."
      },
      "device_command_message_type": {
        "type": "string",
        "default": "",
        "description": "Protocol envelope type; empty disables device command forwarding."
      },
      "emotion_rules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "emotion": {
              "type": "string",
              "enum": ["neutral", "happy", "laughing", "sad", "angry", "thinking", "relaxed", "confident"]
            },
            "keywords": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 32 },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": ["emotion", "keywords"],
          "additionalProperties": false
        },
        "maxItems": 16,
        "default": [],
        "description": "Ordered product-owned keyword rules for optional Xiaozhi display emotions. Empty disables emotion messages."
      },
      "default_emotion": {
        "type": "string",
        "enum": ["neutral", "happy", "laughing", "sad", "angry", "thinking", "relaxed", "confident"],
        "default": "neutral"
      }
    },
    "required": ["control_host", "control_port"],
    "additionalProperties": false
  }
}
