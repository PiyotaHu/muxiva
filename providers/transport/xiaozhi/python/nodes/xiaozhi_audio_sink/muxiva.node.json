{
  "format": "muxiva.node/v1",
  "package_id": "xiaozhi_audio_sink",
  "display_name": "Xiaozhi Audio Egress",
  "node_type": "xiaozhi.audio_sink",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "sink",
  "entrypoint": "node:XiaozhiAudioSinkNode",
  "category": "transport",
  "capability": "xiaozhi.audio.egress",
  "summary": "Publishes TTS PCM Audio Frames to the shared Xiaozhi gateway for Opus encoding and device playback.",
  "documentation": "https://piyotahu.github.io/muxiva/providers/xiaozhi/audio-egress/",
  "tags": ["xiaozhi", "websocket", "opus", "audio", "egress", "realtime"],
  "ports": [
    {
      "name": "audio_in",
      "direction": "input",
      "frame_type": "audio",
      "schema": {
        "encoding": "pcm_s16le",
        "sample_rate_hz": 16000,
        "channels": 1,
        "frame_duration_ms": 60,
        "streaming": true
      }
    },
    {
      "name": "signal_in",
      "direction": "input",
      "frame_type": "signal",
      "schema": { "semantics": ["turn_cancellation"], "signal_names": ["muxiva.turn.cancelled"] }
    },
    {
      "name": "event_in",
      "direction": "input",
      "frame_type": "event",
      "schema": { "semantics": ["tts_media_drain_barrier"] }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "control_host": { "type": "string", "default": "127.0.0.1" },
      "control_port": { "type": "integer", "default": 8889 }
    },
    "required": ["control_host", "control_port"],
    "additionalProperties": false
  }
}
