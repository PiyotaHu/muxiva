@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_library(VOXA_FFI_LIBRARY
  NAMES voxa_ffi
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
  NO_DEFAULT_PATH
  REQUIRED)

if(NOT TARGET Voxa::ffi)
  add_library(Voxa::ffi SHARED IMPORTED)
  set_target_properties(Voxa::ffi PROPERTIES
    IMPORTED_LOCATION "${VOXA_FFI_LIBRARY}")
endif()

if(NOT TARGET Voxa::cpp)
  add_library(Voxa::cpp INTERFACE IMPORTED)
  set_target_properties(Voxa::cpp PROPERTIES
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES Voxa::ffi)
endif()

find_library(VOXA_AGORA_LIBRARY
  NAMES voxa_agora
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
  NO_DEFAULT_PATH)
if(VOXA_AGORA_LIBRARY AND NOT TARGET Voxa::agora)
  add_library(Voxa::agora STATIC IMPORTED)
  set_target_properties(Voxa::agora PROPERTIES
    IMPORTED_LOCATION "${VOXA_AGORA_LIBRARY}"
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES Voxa::cpp)
  if(@VOXA_ENABLE_AGORA@)
    set(VOXA_AGORA_SDK_ROOT "" CACHE PATH "Agora Native C++ SDK root")
    find_library(VOXA_AGORA_VENDOR_LIBRARY
      NAMES agora_rtc_sdk AgoraRtcKit
      PATHS "${VOXA_AGORA_SDK_ROOT}"
      PATH_SUFFIXES lib libs libs/x86_64
      REQUIRED)
    set_property(TARGET Voxa::agora APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES "${VOXA_AGORA_VENDOR_LIBRARY}")
  endif()
endif()

find_library(VOXA_MEDIA_LIBRARY
  NAMES voxa_media
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
  NO_DEFAULT_PATH)
if(VOXA_MEDIA_LIBRARY AND NOT TARGET Voxa::media)
  add_library(Voxa::media STATIC IMPORTED)
  set_target_properties(Voxa::media PROPERTIES
    IMPORTED_LOCATION "${VOXA_MEDIA_LIBRARY}"
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
  if(@VOXA_ENABLE_FFMPEG@)
    set(VOXA_FFMPEG_ROOT "" CACHE PATH "FFmpeg installation prefix")
    find_library(VOXA_AVUTIL_LIBRARY NAMES avutil
      PATHS "${VOXA_FFMPEG_ROOT}" PATH_SUFFIXES lib REQUIRED)
    find_library(VOXA_SWRESAMPLE_LIBRARY NAMES swresample
      PATHS "${VOXA_FFMPEG_ROOT}" PATH_SUFFIXES lib REQUIRED)
    find_library(VOXA_SWSCALE_LIBRARY NAMES swscale
      PATHS "${VOXA_FFMPEG_ROOT}" PATH_SUFFIXES lib REQUIRED)
    set_property(TARGET Voxa::media APPEND PROPERTY INTERFACE_LINK_LIBRARIES
      "${VOXA_AVUTIL_LIBRARY};${VOXA_SWRESAMPLE_LIBRARY};${VOXA_SWSCALE_LIBRARY}")
  endif()
endif()

check_required_components(Voxa)
