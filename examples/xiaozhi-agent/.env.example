# Xiaozhi voice assistant credentials. Copy to .env and fill once.

# Alibaba Cloud Model Studio (Beijing) — used for Qwen ASR, TTS, and the
# default LLM (qwen-flash through the OpenAI-compatible endpoint).
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_WORKSPACE_ID=your-workspace-id

# Optional: switch the built-in LLM node to another OpenAI-compatible provider
# by editing graph.json (endpoint / model / api_key_env). Examples:
#   DeepSeek:  endpoint=https://api.deepseek.com/v1  model=deepseek-chat  DEEPSEEK_API_KEY=...
#   OpenAI:    endpoint=https://api.openai.com/v1     model=gpt-4o-mini    OPENAI_API_KEY=...
#   Ollama:    endpoint=http://127.0.0.1:11434/v1     model=qwen2.5:7b     (no key)
