{
  "format": "voxa.node/v1",
  "package_id": "qwen_tts_realtime",
  "display_name": "Qwen Streaming TTS",
  "node_type": "qwen.tts_realtime",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenTtsRealtimeNode",
  "category": "algorithm",
  "capability": "speech.tts.streaming",
  "summary": "Synthesizes incremental text into streaming PCM speech.",
  "connection_id": "dashscope",
  "documentation": "https://piyotahu.github.io/Voxa/en/providers/qwen/tts-realtime/",
  "tags": ["tts", "text-to-speech", "streaming"],
  "ports": [
    { "name": "text_in", "direction": "input", "frame_type": "text", "schema": { "semantics": "synthesis_text", "streaming": true } },
    { "name": "audio_out", "direction": "output", "frame_type": "audio", "schema": { "encoding": "pcm_s16le", "sample_rate_hz": 24000, "channels": 1, "streaming": true } }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen3-tts-flash-realtime" },
      "voice": { "type": "string", "default": "Cherry" },
      "language_type": { "type": "string", "default": "Auto" }
    },
    "required": ["model", "voice"],
    "additionalProperties": false
  }
