      { "id": "interrupt-stale-text", "from": { "node_id": "qwen-vad-asr", "port": "signal_out" }, "to": { "node_id": "response-cancellation-gate", "port": "signal_in" }, "frame_type": "signal", "queue_policy": { "capacity": 32, "overflow": "block" } },
