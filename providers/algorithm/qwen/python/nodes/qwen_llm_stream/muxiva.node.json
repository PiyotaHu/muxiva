{
  "format": "muxiva.node/v1",
  "package_id": "qwen_llm_stream",
  "display_name": "Qwen Streaming LLM",
  "node_type": "qwen.llm_stream",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenLlmStreamNode",
  "category": "algorithm",
  "capability": "language.generation.streaming",
  "summary": "Generates incremental assistant responses from transcript or context text.",
  "connection_id": "dashscope",
  "documentation": "https://piyotahu.github.io/muxiva/en/providers/qwen/llm-stream/",
  "tags": ["llm", "generation", "streaming"],
  "ports": [
    { "name": "text_in", "direction": "input", "frame_type": "text", "schema": { "semantics": "prompt_or_context", "streaming": true } },
    { "name": "text_out", "direction": "output", "frame_type": "text", "schema": { "semantics": "assistant_delta", "streaming": true } },
    { "name": "client_event_out", "direction": "output", "frame_type": "event", "schema": { "semantics": ["client_realtime_event"], "streaming": true } }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen-flash" },
      "system_prompt": { "type": "string", "default": "You are Muxiva, a warm, concise real-time voice assistant. Respond in the user's language." },
      "temperature": { "type": "number", "default": 0.6 }
    },
    "required": ["model", "system_prompt"],
    "additionalProperties": false
  }
}
