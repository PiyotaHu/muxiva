{
  "format": "voxa.node/v1",
  "package_id": "qwen_llm_stream",
  "display_name": "Qwen Streaming LLM",
  "node_type": "provider.qwen.llm_stream",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenLlmStreamNode",
  "ports": [
    { "name": "text_in", "direction": "input", "frame_type": "text" },
    { "name": "text_out", "direction": "output", "frame_type": "text" }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen-flash" },
      "system_prompt": { "type": "string", "default": "You are Voxa, a warm, concise real-time voice assistant. Respond in the user's language." },
      "temperature": { "type": "number", "default": 0.6 }
    },
    "required": ["model", "system_prompt"],
    "additionalProperties": false
  },
  "connection": {
    "id": "dashscope",
    "display_name": "Alibaba Cloud Model Studio",
    "description": "Credentials for Python Qwen Node Packs",
    "fields": [
      { "name": "api_key", "label": "API Key", "environment": "DASHSCOPE_API_KEY", "secret": true, "required": true, "default": "" },
      { "name": "workspace_id", "label": "Workspace ID", "environment": "DASHSCOPE_WORKSPACE_ID", "secret": false, "required": true, "default": "" }
    ]
  }
}
