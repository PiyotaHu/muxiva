{
  "format": "muxiva.node/v1",
  "package_id": "xiaozhi_audio_source",
  "display_name": "Xiaozhi Audio Ingress",
  "node_type": "xiaozhi.audio_source",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "source",
  "entrypoint": "node:XiaozhiAudioSourceNode",
  "category": "transport",
  "capability": "xiaozhi.audio.ingress",
  "summary": "Hosts the Xiaozhi ESP32 WebSocket server, decodes Opus into 16 kHz PCM Audio Frames, and maps authoritative client abort to a turn interruption request.",
  "connection_id": null,
  "documentation": "https://piyotahu.github.io/muxiva/providers/xiaozhi/audio-ingress/",
  "tags": ["xiaozhi", "websocket", "opus", "audio", "ingress", "realtime"],
  "ports": [
    {
      "name": "audio_out",
      "direction": "output",
      "frame_type": "audio",
      "schema": {
        "encoding": "pcm_s16le",
        "sample_rate_hz": 16000,
        "channels": 1,
        "frame_duration_ms": 60,
        "streaming": true
      }
    },
    {
      "name": "event_out",
      "direction": "output",
      "frame_type": "event",
      "schema": { "semantics": ["client_hello", "client_listen", "client_abort"] }
    },
    {
      "name": "signal_out",
      "direction": "output",
      "frame_type": "signal",
      "schema": { "semantics": ["turn_interrupt_request"], "signal_names": ["muxiva.turn.interrupt.requested"] }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "ws_host": { "type": "string", "default": "0.0.0.0" },
      "ws_port": { "type": "integer", "default": 8888 },
      "control_host": { "type": "string", "default": "127.0.0.1" },
      "control_port": { "type": "integer", "default": 8889 },
      "sample_rate": { "type": "integer", "default": 16000 },
      "frame_duration_ms": { "type": "integer", "default": 60 },
      "playback_prebuffer_ms": { "type": "integer", "minimum": 60, "maximum": 5000, "default": 1200 },
      "playback_initial_burst_frames": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5, "description": "Number of leading Opus frames used to seed the ESP32 playback jitter buffer before real-time pacing begins." },
      "playback_initial_burst_interval_ms": { "type": "integer", "minimum": 0, "maximum": 59, "default": 12, "description": "Spacing between startup frames. A small value builds client buffer lead without overwhelming constrained firmware receive queues." },
      "playback_queue_ms": { "type": "integer", "minimum": 30000, "maximum": 300000, "default": 120000 },
      "playback_stop_grace_ms": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 1000, "description": "Quiet time after the last delivered audio packet before sending tts/stop." },
      "playback_no_audio_stop_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 30000, "default": 5000, "description": "Fail-safe delay before sending tts/stop when a turn produced no audio." }
    },
    "required": ["ws_host", "ws_port", "control_host", "control_port", "sample_rate", "frame_duration_ms"],
    "additionalProperties": false
  }
}
