{
  "format": "voxa.node/v1",
  "package_id": "qwen_tts_realtime",
  "display_name": "Qwen Streaming TTS",
  "node_type": "provider.qwen.tts_realtime",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenTtsRealtimeNode",
  "ports": [
    { "name": "text_in", "direction": "input", "frame_type": "text" },
    { "name": "audio_out", "direction": "output", "frame_type": "audio" }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen3-tts-flash-realtime" },
      "voice": { "type": "string", "default": "Cherry" },
      "language_type": { "type": "string", "default": "Auto" }
    },
    "required": ["model", "voice"],
    "additionalProperties": false
  },
  "connection": {
    "id": "dashscope",
    "display_name": "Alibaba Cloud Model Studio",
    "description": "Credentials for Python Qwen Node Packs",
    "fields": [
      { "name": "api_key", "label": "API Key", "environment": "DASHSCOPE_API_KEY", "secret": true, "required": true, "default": "" },
      { "name": "workspace_id", "label": "Workspace ID", "environment": "DASHSCOPE_WORKSPACE_ID", "secret": false, "required": true, "default": "" }
    ]
  }
}
