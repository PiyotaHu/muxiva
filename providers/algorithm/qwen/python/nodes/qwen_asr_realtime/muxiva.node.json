{
  "format": "muxiva.node/v1",
  "package_id": "qwen_asr_realtime",
  "display_name": "Qwen Server VAD + Streaming ASR",
  "node_type": "qwen.asr_realtime",
  "language": "python",
  "factory_version": "1.2.0",
  "kind": "transform",
  "entrypoint": "node:QwenAsrRealtimeNode",
  "category": "algorithm",
  "capability": "speech.vad_asr.streaming",
  "summary": "Uses Qwen Server VAD and streaming ASR to emit speech state, interruption Signals, and transcripts.",
  "connection_id": "dashscope",
  "documentation": "https://piyotahu.github.io/muxiva/providers/qwen/asr-realtime/",
  "tags": ["vad", "asr", "speech-to-text", "barge-in", "streaming"],
  "ports": [
    { "name": "audio_in", "direction": "input", "frame_type": "audio", "schema": { "encoding": "pcm_s16le", "sample_rate_hz": 16000, "channels": 1, "streaming": true } },
    { "name": "speech_out", "direction": "output", "frame_type": "event", "schema": { "semantics": ["speech_started", "speech_stopped"], "detector": "qwen_server_vad", "streaming": true } },
    { "name": "signal_out", "direction": "output", "frame_type": "signal", "schema": { "semantics": ["graph_control", "barge_in"], "streaming": true } },
    { "name": "transcript_preview_out", "direction": "output", "frame_type": "text", "schema": { "semantics": ["partial_transcript"], "streaming": true } },
    { "name": "text_out", "direction": "output", "frame_type": "text", "schema": { "semantics": ["final_transcript"], "streaming": false } },
    { "name": "event_out", "direction": "output", "frame_type": "event", "schema": { "semantics": ["transcript_failure"], "streaming": true } }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen3-asr-flash-realtime" },
      "language": { "type": "string", "default": "zh" },
      "vad_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
      "silence_duration_ms": { "type": "integer", "minimum": 200, "maximum": 6000, "default": 500 }
    },
    "required": ["model", "language"],
    "additionalProperties": false
  }
}
