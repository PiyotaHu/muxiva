{
  "id": "qwen-cascade",
  "name": "Qwen Cascade",
  "badge": "Inspectable",
  "description": "Inspectable full-duplex Graph: official C++ Agora Nodes, reusable Rust media/context Nodes, and replaceable Python Qwen ASR, LLM and TTS Nodes.",
  "traits": ["replaceable stages", "Python intelligence", "C++ RTC"],
  "graph": {
    "version": "voxa.graph/v1",
    "graph_id": "agora-qwen-cascade",
    "nodes": [      { "id": "agora-in", "node_type": "agora.audio_source", "language": "cpp", "factory_version": "1.1.0", "node_config": {} },
      { "id": "asr-input-resampler", "node_type": "builtin.audio_resampler", "language": "rust", "factory_version": "1.0.0", "node_config": { "input": { "sample_format": "pcm_s16le", "sample_rate_hz": 16000, "channels": 1 }, "output": { "sample_format": "pcm_s16le", "sample_rate_hz": 16000, "channels": 1 } } },
      { "id": "vad", "node_type": "builtin.audio_vad", "language": "rust", "factory_version": "1.0.0", "node_config": { "threshold": 600, "start_frames": 2, "stop_frames": 18 } },
      { "id": "asr", "node_type": "qwen.asr_realtime", "language": "python", "factory_version": "1.0.0", "node_config": { "model": "qwen3-asr-flash-realtime", "language": "zh", "vad_threshold": 0.2, "silence_duration_ms": 500 } },
      { "id": "turn-context", "node_type": "builtin.voice_turn_context", "language": "rust", "factory_version": "1.0.0", "node_config": {} },
      { "id": "llm", "node_type": "qwen.llm_stream", "language": "python", "factory_version": "1.0.0", "node_config": { "model": "qwen-flash", "system_prompt": "You are Voxa, a warm, concise real-time voice assistant. Respond in the user's language.", "temperature": 0.6 } },
      { "id": "response-cancellation-gate", "node_type": "builtin.text_cancellation_gate", "language": "rust", "factory_version": "1.0.0", "node_config": {} },
      { "id": "tts", "node_type": "qwen.tts_realtime", "language": "python", "factory_version": "1.0.0", "node_config": { "model": "qwen3-tts-flash-realtime", "voice": "Cherry", "language_type": "Auto" } },
      { "id": "rtc-output-resampler", "node_type": "builtin.audio_resampler", "language": "rust", "factory_version": "1.0.0", "node_config": { "input": { "sample_format": "pcm_s16le", "sample_rate_hz": 24000, "channels": 1 }, "output": { "sample_format": "pcm_s16le", "sample_rate_hz": 48000, "channels": 1 } } },
      { "id": "agora-out", "node_type": "agora.audio_sink", "language": "cpp", "factory_version": "1.0.0", "node_config": {} },
      { "id": "client-event-encoder", "node_type": "builtin.client_event_encoder", "language": "rust", "factory_version": "1.0.0", "node_config": {} },
      { "id": "agora-data-sink", "node_type": "agora.data_sink", "language": "cpp", "factory_version": "1.0.0", "node_config": {} },
      { "id": "captions", "node_type": "builtin.stdout_text_sink", "language": "rust", "factory_version": "1.0.0", "node_config": {} }
    ],
    "edges": [      { "id": "agora-input", "from": { "node_id": "agora-in", "port": "audio_out" }, "to": { "node_id": "asr-input-resampler", "port": "audio_in" }, "frame_type": "audio", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "audio-to-vad", "from": { "node_id": "asr-input-resampler", "port": "audio_out" }, "to": { "node_id": "vad", "port": "audio_in" }, "frame_type": "audio", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "audio-to-asr", "from": { "node_id": "asr-input-resampler", "port": "audio_out" }, "to": { "node_id": "asr", "port": "audio_in" }, "frame_type": "audio", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "vad-to-turn", "from": { "node_id": "vad", "port": "speech_out" }, "to": { "node_id": "turn-context", "port": "speech_in" }, "frame_type": "event", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "asr-to-turn", "from": { "node_id": "asr", "port": "text_out" }, "to": { "node_id": "turn-context", "port": "transcript_in" }, "frame_type": "text", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "turn-to-llm", "from": { "node_id": "turn-context", "port": "context_out" }, "to": { "node_id": "llm", "port": "text_in" }, "frame_type": "text", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "llm-to-response-gate", "from": { "node_id": "llm", "port": "text_out" }, "to": { "node_id": "response-cancellation-gate", "port": "text_in" }, "frame_type": "text", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "response-gate-to-captions", "from": { "node_id": "response-cancellation-gate", "port": "text_out" }, "to": { "node_id": "captions", "port": "text_in" }, "frame_type": "text", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "response-gate-to-tts", "from": { "node_id": "response-cancellation-gate", "port": "text_out" }, "to": { "node_id": "tts", "port": "text_in" }, "frame_type": "text", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "tts-audio", "from": { "node_id": "tts", "port": "audio_out" }, "to": { "node_id": "rtc-output-resampler", "port": "audio_in" }, "frame_type": "audio", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "audio-to-room", "from": { "node_id": "rtc-output-resampler", "port": "audio_out" }, "to": { "node_id": "agora-out", "port": "audio_in" }, "frame_type": "audio", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "vad-interrupt-to-room", "from": { "node_id": "vad", "port": "signal_out" }, "to": { "node_id": "agora-out", "port": "signal_in" }, "frame_type": "signal", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "vad-interrupt-response", "from": { "node_id": "vad", "port": "signal_out" }, "to": { "node_id": "response-cancellation-gate", "port": "signal_in" }, "frame_type": "signal", "queue_policy": { "capacity": 32, "overflow": "block" } },
      { "id": "vad-client-events", "from": { "node_id": "vad", "port": "speech_out" }, "to": { "node_id": "client-event-encoder", "port": "event_in" }, "frame_type": "event", "queue_policy": { "capacity": 64, "overflow": "block" } },
      { "id": "asr-client-events", "from": { "node_id": "asr", "port": "client_event_out" }, "to": { "node_id": "client-event-encoder", "port": "event_in" }, "frame_type": "event", "queue_policy": { "capacity": 64, "overflow": "block" } },
      { "id": "llm-client-events", "from": { "node_id": "llm", "port": "client_event_out" }, "to": { "node_id": "client-event-encoder", "port": "event_in" }, "frame_type": "event", "queue_policy": { "capacity": 64, "overflow": "block" } },
      { "id": "client-events-to-room", "from": { "node_id": "client-event-encoder", "port": "message_out" }, "to": { "node_id": "agora-data-sink", "port": "message_in" }, "frame_type": "byte", "queue_policy": { "capacity": 64, "overflow": "block" } }
    ]
  }
}
