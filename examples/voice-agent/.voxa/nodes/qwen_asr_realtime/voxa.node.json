{
  "format": "voxa.node/v1",
  "package_id": "qwen_asr_realtime",
  "display_name": "Qwen Streaming ASR",
  "node_type": "provider.qwen.asr_realtime",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenAsrRealtimeNode",
  "ports": [
    { "name": "audio_in", "direction": "input", "frame_type": "audio" },
    { "name": "text_out", "direction": "output", "frame_type": "text" }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen3-asr-flash-realtime" },
      "language": { "type": "string", "default": "zh" },
      "vad_threshold": { "type": "number", "default": 0.2 },
      "silence_duration_ms": { "type": "integer", "default": 500 }
    },
    "required": ["model", "language"],
    "additionalProperties": false
  },
  "connection": {
    "id": "dashscope",
    "display_name": "Alibaba Cloud Model Studio",
    "description": "Credentials for Python Qwen Node Packs",
    "fields": [
      { "name": "api_key", "label": "API Key", "environment": "DASHSCOPE_API_KEY", "secret": true, "required": true, "default": "" },
      { "name": "workspace_id", "label": "Workspace ID", "environment": "DASHSCOPE_WORKSPACE_ID", "secret": false, "required": true, "default": "" }
    ]
  }
}
