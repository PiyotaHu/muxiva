# Copy this file to .env and fill it once. `muxiva run` and `muxiva serve`
# load the project-local file automatically; Studio is an optional editor.
# .env is local-only and Git ignored.
MUXIVA_AGORA_APP_ID=""
MUXIVA_AGORA_CHANNEL="muxiva-demo"
MUXIVA_AGORA_BOT_UID="2001"
MUXIVA_AGORA_BOT_TOKEN=""
MUXIVA_AGORA_WEB_UID="1001"
MUXIVA_AGORA_WEB_TOKEN=""
DASHSCOPE_API_KEY=""
DASHSCOPE_WORKSPACE_ID=""
# Required when `muxiva serve` binds a non-loopback address. Generate a random
# 32+ character value and paste the same value into the standalone Voice Room.
MUXIVA_CLIENT_API_TOKEN=""
