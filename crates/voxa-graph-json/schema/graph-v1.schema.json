{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxa.dev/schema/graph-v1.schema.json",
  "title": "Voxa Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "graph_id", "nodes", "edges"],
  "properties": {
    "version": { "const": "voxa.graph/v1" },
    "graph_id": { "$ref": "#/$defs/identifier" },
    "nodes": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_type", "language", "factory_version", "node_config"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "node_type": { "$ref": "#/$defs/identifier" },
        "language": {
          "enum": ["rust", "cpp", "python", "typescript"]
        },
        "factory_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+\\-]+$"
        },
        "node_config": { "type": "object" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "port"],
      "properties": {
        "node_id": { "$ref": "#/$defs/identifier" },
        "port": { "$ref": "#/$defs/identifier" }
      }
    },
    "queue_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "overflow"],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "overflow": {
          "enum": ["block", "drop_oldest", "drop_newest", "abort"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "frame_type", "queue_policy"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "frame_type": {
          "enum": ["audio", "video", "text", "byte", "signal", "event"]
        },
        "queue_policy": { "$ref": "#/$defs/queue_policy" }
      }
    }
  }
}
