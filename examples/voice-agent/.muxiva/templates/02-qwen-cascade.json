      { "id": "response-gate-to-tts", "from": { "node_id": "response-cancellation-gate", "port": "text_out" }, "to": { "node_id": "qwen-tts", "port": "text_in" }, "frame_type": "text", "queue_policy": { "capacity": 32, "overflow": "block" } },
