@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_library(MUXIVA_FFI_LIBRARY
  NAMES muxiva_ffi
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
  NO_DEFAULT_PATH
  REQUIRED)

if(NOT TARGET Muxiva::ffi)
  add_library(Muxiva::ffi SHARED IMPORTED)
  set_target_properties(Muxiva::ffi PROPERTIES
    IMPORTED_LOCATION "${MUXIVA_FFI_LIBRARY}")
endif()

if(NOT TARGET Muxiva::cpp)
  add_library(Muxiva::cpp INTERFACE IMPORTED)
  set_target_properties(Muxiva::cpp PROPERTIES
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES Muxiva::ffi)
endif()

find_library(MUXIVA_MEDIA_LIBRARY
  NAMES muxiva_media
  PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
  NO_DEFAULT_PATH)
if(MUXIVA_MEDIA_LIBRARY AND NOT TARGET Muxiva::media)
  add_library(Muxiva::media STATIC IMPORTED)
  set_target_properties(Muxiva::media PROPERTIES
    IMPORTED_LOCATION "${MUXIVA_MEDIA_LIBRARY}"
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
  if(@MUXIVA_ENABLE_FFMPEG@)
    set(MUXIVA_FFMPEG_ROOT "" CACHE PATH "FFmpeg installation prefix")
    find_library(MUXIVA_AVUTIL_LIBRARY NAMES avutil
      PATHS "${MUXIVA_FFMPEG_ROOT}" PATH_SUFFIXES lib REQUIRED)
    find_library(MUXIVA_SWRESAMPLE_LIBRARY NAMES swresample
      PATHS "${MUXIVA_FFMPEG_ROOT}" PATH_SUFFIXES lib REQUIRED)
    find_library(MUXIVA_SWSCALE_LIBRARY NAMES swscale
      PATHS "${MUXIVA_FFMPEG_ROOT}" PATH_SUFFIXES lib REQUIRED)
    set_property(TARGET Muxiva::media APPEND PROPERTY INTERFACE_LINK_LIBRARIES
      "${MUXIVA_AVUTIL_LIBRARY};${MUXIVA_SWRESAMPLE_LIBRARY};${MUXIVA_SWSCALE_LIBRARY}")
  endif()
endif()

check_required_components(Muxiva)
