{
  "format": "voxa.node/v1",
  "package_id": "qwen_realtime",
  "display_name": "Qwen Audio Realtime",
  "node_type": "provider.qwen.audio_realtime",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:QwenAudioRealtimeNode",
  "ports": [
    { "name": "audio_in", "direction": "input", "frame_type": "audio" },
    { "name": "audio_out", "direction": "output", "frame_type": "audio" },
    { "name": "text_out", "direction": "output", "frame_type": "text" }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model": { "type": "string", "default": "qwen-audio-3.0-realtime-flash" },
      "voice": { "type": "string", "default": "longanqian" },
      "instructions": { "type": "string", "default": "You are a concise, helpful realtime voice assistant." },
      "turn_detection": { "type": "string", "enum": ["server_vad", "smart_turn"], "default": "smart_turn" }
    },
    "required": ["model", "voice", "instructions", "turn_detection"],
    "additionalProperties": false
  },
  "connection": {
    "id": "dashscope",
    "display_name": "Alibaba Cloud Model Studio",
    "description": "Credentials for Python Qwen Node Packs",
    "fields": [
      { "name": "api_key", "label": "API Key", "environment": "DASHSCOPE_API_KEY", "secret": true, "required": true, "default": "" },
      { "name": "workspace_id", "label": "Workspace ID", "environment": "DASHSCOPE_WORKSPACE_ID", "secret": false, "required": true, "default": "" }
    ]
  }
}
